# ============================================================
# Antigravity Kit — OpenCode Environment Variables
# Loaded automatically by opencode from ~/.config/opencode/.env
# DO NOT COMMIT — already gitignored (.gitignore: .env, .env.*)
# ============================================================

# --- Provider: 9router ---
ROUTER_9_BASE_URL=http://localhost:20128/v1
ROUTER_9_API_KEY=sk-apikey

# --- MCP: Notion (both servers share one token) ---
NOTION_TOKEN= 
NOTION_API_TOKEN=

# --- MCP: Context7 ---
CONTEXT7_API_KEY=

# --- MCP: Figma ---
FIGMA_ACCESS_TOKEN=

# --- MCP: Netlify ---
# Tạo PAT tại: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_PERSONAL_ACCESS_TOKEN=

# --- Misc ---
HOST=
