{
  "plugin": [
    "opencode-websearch-cited",
    "opencode-agents-sidebar@latest"
  ],
  "model": "",
  "autoupdate": true,
  "small_model": "",
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/rules/RULES.md"
  ],
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.16:20128/v1",
        "apiKey": "sk-PASTE-YOUR-API-KEY"
      },
      "models": {
        "pro": {
          "name": "pro"
        },
        "soft": {
          "name": "soft"
        },
        "flex": {
          "name": "flex"
        },
        "deepseek": {
          "name": "deepseek"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "env",
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": false
    },
    "tailwindcss": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tailwindcss-mcp-server"
      ],
      "enabled": false
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      }
    },
    "notion-suekou": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@suekou/mcp-notion-server"
      ],
      "enabled": true,
      "environment": {
        "NOTION_API_TOKEN": "{env:NOTION_API_TOKEN}"
      }
    },
    "shadcn": {
      "type": "local",
      "command": [
        "env",
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": false
    },
    "figma": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "@vkhanhqui/figma-mcp-go"
      ],
      "environment": {
        "FIGMA_ACCESS_TOKEN": "{env:FIGMA_ACCESS_TOKEN}"
      }
    },
    "netlify": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@netlify/mcp"
      ],
      "enabled": true,
      "environment": {
        "NETLIFY_PERSONAL_ACCESS_TOKEN": "{env:NETLIFY_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "lazyweb": {
      "type": "remote",
      "url": "https://www.lazyweb.com/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {file:~/.lazyweb/lazyweb_mcp_token}"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "allow",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "allow",
      "git status": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run*": "ask",
      "pnpm *": "allow",
      "node *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "ls*": "allow",
      "dir*": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "glob": "allow",
    "list": "allow",
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    },
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/pro"
    },
    "build": {
      "mode": "primary",
      "prompt": "{file:~/.config/opencode/prompts/build.txt}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git status": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "npm run*": "allow",
          "pnpm *": "allow",
          "node *": "allow"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "review": {
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow"
        },
        "webfetch": "deny"
      }
    },
    "debugger": {
      "mode": "subagent",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "grep *": "allow",
          "find *": "allow"
        }
      }
    }
  },
  "command": {
    "deploy-check": {
      "description": "Check deployment readiness",
      "template": "Review recent changes and check if the project is ready to deploy.\n!`git diff HEAD~1 --stat`\nList any blockers.",
      "agent": "plan"
    }
  },
  "default_agent": "build"
}